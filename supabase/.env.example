# Copy to supabase/.env for `supabase secrets set --env-file supabase/.env`
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically on deploy.

GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
PRIMARY_USER_NAME=Rasiya
YOUTUBE_API_KEY=
TAVILY_API_KEY=
MACHINE_BRAND=Usha
MACHINE_MODEL=Quick Stitch Master
API_AUTH_TOKEN=
# Comma-separated exact browser origins allowed to call the API. Include the
# production Netlify origin and local dev origin(s), with no trailing slash.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
