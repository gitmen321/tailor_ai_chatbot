# Copy to supabase/.env for `supabase secrets set --env-file supabase/.env`
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically on deploy.

GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Used by the separate legacy WhatsApp adapter only. PWA identity comes from Supabase Auth.
PRIMARY_USER_NAME=
YOUTUBE_API_KEY=
TAVILY_API_KEY=
MACHINE_BRAND=Usha
MACHINE_MODEL=Quick Stitch Master
# Fresh, server-only credential for the existing Baileys adapter; rotate the old shared token.
WHATSAPP_API_AUTH_TOKEN=
# Shared durable limiter (Upstash Redis REST API). Required before enabling paid API routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Conservative defaults; tune from measured usage and provider cost.
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_USER_DAILY_LIMIT=100
CHAT_GLOBAL_DAILY_LIMIT=1000
MEDIA_RATE_LIMIT_PER_MINUTE=20
MEDIA_USER_DAILY_LIMIT=50
MEDIA_GLOBAL_DAILY_LIMIT=2000
PROFILE_RATE_LIMIT_PER_MINUTE=30
API_IP_RATE_LIMIT_PER_MINUTE=60
# Comma-separated exact browser origins allowed to call the API. Include the
# production Netlify origin and local dev origin(s), with no trailing slash.
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
