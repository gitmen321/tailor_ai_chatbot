# Leave empty. Local Vite and Netlify both proxy /api — do not set a Railway URL.
# Local: Vite proxies /api to the Edge Function on http://127.0.0.1:8787
# Production: Netlify proxies /api to Supabase Edge Functions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Set this when CAPTCHA protection is enabled in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
